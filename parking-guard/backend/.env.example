# Application
APP_NAME=ParkingGuard
APP_VERSION=1.0.0
SECRET_KEY=your-super-secret-key-change-this
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./parking_guard.db

# Redis (for real-time events)
REDIS_URL=redis://localhost:6379

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+60123456789

# Raspberry Pi Stream
PI_STREAM_URL=http://raspberrypi.local:8554/stream
PI_API_URL=http://raspberrypi.local:5000

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AI Models
YOLO_MODEL_PATH=./ai-models/yolov8n.pt
PLATE_MODEL_PATH=./ai-models/plate_detector.pt
FACE_ENCODINGS_PATH=./ai-models/face_encodings.pkl

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
