# ================================================================
# PARKINGGUARD KONFIGURASI
# Edit fail ini sebelum pasang atau semasa setup wizard
# ================================================================

# IP address pelayan backend anda (PC/server yang run FastAPI)
# Contoh: http://192.168.1.100:8000
BACKEND_URL=http://192.168.1.100:8000

# Nama zon kamera ini (untuk log)
ZONE=driveway

# Selang tangkapan gambar (saat) - lebih kecil = lebih cepat tapi lebih beban CPU
CAPTURE_INTERVAL=2.0

# Port Flask API pada Pi ini (jangan ubah kecuali ada konflik)
FLASK_PORT=5000

# Log level: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
