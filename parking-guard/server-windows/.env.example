# ================================================================
# I DEFENDER SERVER — KONFIGURASI
# Salin fail ini sebagai .env dan isi nilai yang betul
# ================================================================

APP_NAME=I Defender
APP_VERSION=1.0.0
SECRET_KEY=idefender-secret-key-tukar-ini-kepada-sesuatu-yang-panjang
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database (SQLite — simpan dalam folder semasa)
DATABASE_URL=sqlite:///./idefender.db

# Redis (tidak wajib untuk mod asas)
REDIS_URL=redis://localhost:6379

# ── WhatsApp Twilio ────────────────────────────────────────────
# Daftar percuma di https://twilio.com
# Pergi ke Console > Messaging > Try WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# No. WhatsApp anda (untuk terima notifikasi)
# Format: whatsapp:+601XXXXXXXX
OWNER_WHATSAPP=whatsapp:+60123456789

# ── Raspberry Pi ──────────────────────────────────────────────
# IP Pi akan auto-detect — tinggalkan default
PI_STREAM_URL=http://raspberrypi.local:8554/stream
PI_API_URL=http://raspberrypi.local:5000

# ── Folder simpan gambar ──────────────────────────────────────
UPLOAD_DIR=./uploads

# ── AI Models ────────────────────────────────────────────────
YOLO_MODEL_PATH=./ai-models/yolov8n.pt
PLATE_MODEL_PATH=./ai-models/yolov8n.pt
FACE_ENCODINGS_PATH=./ai-models/face_encodings.pkl

# JWT Token (minit)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
